type Category {
    categoryId: ID!
    categoryName: String!
    icon: String
    products: [Product]
}

type Product {
    productId: ID!
    productName: String!
    quantity: Int!
    unitPrice: Float!
    discount: Float
    images: String
    description: String
    status: Int
    createDate: String
    category: Category
}

type ProductPage {
    content: [Product]!
    totalPages: Int!
    totalElements: Int!
    currentPage: Int!
    pageSize: Int!
}

type CategoryPage {
    content: [Category]!
    totalPages: Int!
    totalElements: Int!
    currentPage: Int!
    pageSize: Int!
}

input ProductInput {
    productName: String!
    quantity: Int!
    unitPrice: Float!
    discount: Float
    images: String
    description: String
    status: Int
    categoryId: ID!
}

input CategoryInput {
    categoryName: String!
    icon: String
}

type Query {
    # 1. Hiển thị tất cả product có price từ thấp đến cao (mặc định ASC)
    allProductsSortedByPrice(order: String = "ASC"): [Product]!

    # 2. Lấy tất cả product của 01 category
    productsByCategory(categoryId: ID!): [Product]!

    # 3. Phân trang & tìm kiếm Product
    productsPage(name: String, page: Int = 0, size: Int = 6): ProductPage!

    # 4. Phân trang & tìm kiếm Category
    categoriesPage(name: String, page: Int = 0, size: Int = 5): CategoryPage!

    # Các query bổ trợ
    allCategories: [Category]!
    allProducts: [Product]!
    productById(id: ID!): Product
    categoryById(id: ID!): Category
}

type Mutation {
    # CRUD Category
    createCategory(input: CategoryInput!): Category!
    updateCategory(id: ID!, input: CategoryInput!): Category!
    deleteCategory(id: ID!): Boolean!

    # CRUD Product
    createProduct(input: ProductInput!): Product!
    updateProduct(id: ID!, input: ProductInput!): Product!
    deleteProduct(id: ID!): Boolean!
}
